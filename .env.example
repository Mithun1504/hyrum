# Runtime
NODE_ENV=development
LOG_LEVEL=info
WEB_URL=http://localhost:3000
CONTROL_PLANE_URL=http://localhost:4000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:4000
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=4000
# Comma-separated trusted proxy CIDRs. Leave unset for direct/local traffic.
CONTROL_PLANE_TRUST_PROXY_CIDRS=

# PostgreSQL / Neon
DATABASE_URL=postgresql://hyrum:hyrum@localhost:5432/hyrum
WORKER_DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Optional overrides for `pnpm db:seed` (use real WorkOS ids to sign into the seeded tenant)
HYRUM_SEED_WORKOS_ORGANIZATION_ID=org_hyrum_seed
HYRUM_SEED_WORKOS_USER_ID=user_hyrum_seed
HYRUM_SEED_USER_EMAIL=seed-owner@example.test
HYRUM_SEED_ORGANIZATION_NAME=Hyrum Seed Workspace
HYRUM_SEED_AGENT_TOKEN=hyrum_seedagent_replace-with-at-least-16-random-characters
# PEM-encoded Ed25519 public key; when set, the seed agent also receives replay:write.
HYRUM_SEED_SIGNING_PUBLIC_KEY=

# WorkOS AuthKit (required for authenticated routes)
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_JWKS_URL=
WORKOS_ISSUER=https://api.workos.com/

# First-party machine authentication
MACHINE_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# OpenAI (model output is advisory only; deterministic code owns gate decisions)
OPENAI_API_KEY=sk-replace_me
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
OPENAI_HIGH_VALUE_MODEL=gpt-5.6

# Cloudflare R2 / local MinIO (S3-compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=hyrum-development
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MAX_OBJECT_BYTES=26214400
OBJECT_STORAGE_PRESIGN_MAX_SECONDS=300
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=bucket
OBJECT_STORAGE_KMS_KEY_ID=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Slack App
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Observability (optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hyrum-control-plane
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

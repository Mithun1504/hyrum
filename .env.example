# Runtime
NODE_ENV=development
LOG_LEVEL=info
WEB_URL=http://localhost:3000
CONTROL_PLANE_URL=http://localhost:4000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:4000
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=4000
INTERNAL_OPERATIONS_ENABLED=false

# PostgreSQL / Neon
DATABASE_URL=postgresql://hyrum:hyrum@localhost:5432/hyrum
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# WorkOS AuthKit (required for authenticated routes)
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/replace_me
WORKOS_ISSUER=https://api.workos.com
WORKOS_AUDIENCE=replace_me
WORKOS_WEBHOOK_SECRET=whsec_replace_me

# First-party machine authentication
MACHINE_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AGENT_KEY_DERIVATION_SECRET=replace-with-an-independent-32-byte-random-secret

# OpenAI (model output is advisory only; deterministic code owns gate decisions)
OPENAI_API_KEY=sk-replace_me
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
OPENAI_HIGH_VALUE_MODEL=gpt-5.6

# Cloudflare R2 / local MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=hyrum-development
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_ACTIONS_OIDC_AUDIENCE=hyrum-control-plane

# Slack App
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/app/settings/integrations/slack/callback
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Observability (optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hyrum-control-plane
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

{
  "name": "hyrum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo",
    "db:check": "pnpm --filter @hyrum/db db:check",
    "db:generate": "pnpm --filter @hyrum/db db:generate",
    "db:migrate": "pnpm --filter @hyrum/db db:migrate",
    "db:seed": "pnpm --filter @hyrum/db db:seed",
    "db:studio": "pnpm --filter @hyrum/db db:studio",
    "demo:api:base": "DEMO_VARIANT=base PORT=4100 node demo/api/server.mjs",
    "demo:api:candidate": "DEMO_VARIANT=candidate PORT=4200 node demo/api/server.mjs",
    "demo:acceptance": "node scripts/demo-acceptance.mjs",
    "demo:acceptance:test": "node --test scripts/demo-acceptance.test.mjs",
    "demo:evaluate": "node scripts/demo-evaluate.mjs",
    "demo:replay": "node scripts/demo-replay.mjs",
    "demo:seed-traffic": "node demo/consumers/generate.mjs",
    "demo:test": "node --test demo/**/*.test.mjs",
    "dev": "node --env-file-if-exists=.env.local node_modules/turbo/bin/turbo run dev --parallel --env-mode=loose",
    "format": "biome check --write . && prettier --write '**/*.{md,yml,yaml}'",
    "format:check": "biome check . && prettier --check '**/*.{md,yml,yaml}'",
    "generate:openapi": "pnpm --filter @hyrum/control-plane exec tsx ../../scripts/generate-openapi.ts && biome format --write packages/api-client/openapi/control-plane.json packages/api-client/src/generated.ts",
    "check:openapi": "pnpm generate:openapi && git diff --exit-code -- packages/api-client/openapi/control-plane.json packages/api-client/src/generated.ts",
    "lint": "turbo run lint",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hyrum/web test:e2e",
    "test:resilience": "node scripts/resilience-test.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm demo:test && pnpm demo:acceptance:test && pnpm demo:evaluate && pnpm demo:replay && pnpm db:check && pnpm check:openapi && pnpm build && pnpm verify:bundles && pnpm verify:go",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "verify:go": "go test ./... && go vet ./... && go build ./cmd/hyrum-agent ./cmd/hyrum-replay"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "lefthook": "^2.1.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  }
}

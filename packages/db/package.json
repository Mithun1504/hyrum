{
  "name": "@hyrum/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./jobs": "./src/jobs.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check src drizzle.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}

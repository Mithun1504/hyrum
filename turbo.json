{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DEMO_VARIANT",
    "HOST",
    "PORT",
    "NEXT_DIST_DIR",
    "HYRUM_ACCEPTANCE_POSTGRES_PORT",
    "HYRUM_ACCEPTANCE_MINIO_API_PORT",
    "HYRUM_ACCEPTANCE_MINIO_CONSOLE_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    }
  }
}

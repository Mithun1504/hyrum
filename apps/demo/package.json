{
  "name": "@hyrum/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --sourcemap --clean",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",

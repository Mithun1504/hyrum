{
  "name": "@hyrum/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "biome check src",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@hyrum/contracts": "workspace:*",
    "@hyrum/db": "workspace:*",
    "@hyrum/env": "workspace:*",
    "@hyrum/logger": "workspace:*",
    "@hyrum/openai": "workspace:*",
    "@hyrum/integrations": "workspace:*",
    "@hyrum/specs": "workspace:*",
    "@hyrum/storage": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@workos-inc/node": "^10.7.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.1.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
